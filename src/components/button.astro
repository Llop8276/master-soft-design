---
interface Props {
  text: string;
  href: string;
  variant?: "primary" | "secondary" | "outline";
}

const {
  text,
  href,
  variant = "primary"
} = Astro.props;
---

<a class={`button button--${variant}`} href={href}>
  {text}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);

    padding: var(--space-3) var(--space-6);

    border: 1px solid transparent;
    border-radius: var(--radius-md);

    font-family: var(--font-family-base);
    font-size: var(--font-size-base);
    font-weight: 600;

    text-decoration: none;
    cursor: pointer;

    transition:
      background-color var(--transition-normal),
      color var(--transition-normal),
      border-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  /* PRIMARY */

  .button--primary {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .button--primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  /* SECONDARY */

  .button--secondary {
    background-color: var(--color-secondary);
    color: var(--color-surface);
  }

  .button--secondary:hover {
    background-color: var(--color-secondary-hover);
    transform: translateY(-2px);
  }

  /* OUTLINE */

  .button--outline {
    border-color: var(--color-primary);
    background-color: transparent;
    color: var(--color-primary);
  }

  .button--outline:hover {
    background-color: var(--color-primary);
    color: var(--color-surface);
    transform: translateY(-2px);
  }


  /* DARK THEME */

  /* Botón principal */

  :global(html[data-theme="dark"]) .button--primary {
    background-color: #8db9e8;
    border-color: #8db9e8;
    color: #101820;
  }

  :global(html[data-theme="dark"]) .button--primary:hover {
    background-color: #a6caf0;
    border-color: #a6caf0;
    color: #101820;
    box-shadow: 0 5px 18px rgb(141 185 232 / 20%);
  }

  /* Botón secundario */

  :global(html[data-theme="dark"]) .button--secondary {
    background-color: #55c5c0;
    border-color: #55c5c0;
    color: #101820;
  }

  :global(html[data-theme="dark"]) .button--secondary:hover {
    background-color: #72d5d0;
    border-color: #72d5d0;
    color: #101820;
    box-shadow: 0 5px 18px rgb(85 197 192 / 20%);
  }

  /* Botón outline */

  :global(html[data-theme="dark"]) .button--outline {
    background-color: #1c2935;
    border-color: #55c5c0;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .button--outline:hover {
    background-color: #55c5c0;
    border-color: #55c5c0;
    color: #101820;
    box-shadow: 0 5px 18px rgb(85 197 192 / 20%);
  }


  /* ACCESIBILIDAD */

  .button:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .button:active {
    transform: translateY(0);
  }
</style>