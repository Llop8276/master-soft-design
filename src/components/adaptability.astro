---
import Button from "./button.astro";

const benefits = [
  {
    number: "01",
    title: "Evolución",
    description:
      "Creamos soluciones preparadas para crecer, incorporar nuevas funcionalidades y responder a necesidades futuras."
  },
  {
    number: "02",
    title: "Adaptabilidad",
    description:
      "Diseñamos sistemas flexibles que pueden ajustarse a nuevos escenarios, tecnologías y objetivos."
  },
  {
    number: "03",
    title: "Continuidad",
    description:
      "Apostamos por el mantenimiento, la optimización y la mejora constante de cada solución."
  }
];
---

<section class="adaptability">
  <div class="adaptability__content">
    <span class="adaptability__eyebrow">PENSAMOS EN EL FUTURO</span>

    <h2>
      Construimos hoy.
      <span>Evolucionamos mañana.</span>
    </h2>

    <p class="adaptability__description">
      La tecnología cambia constantemente y las necesidades también.
      Por eso, desarrollamos soluciones digitales que pueden crecer,
      adaptarse y mantenerse relevantes a lo largo del tiempo.
    </p>

    <Button
      text="Conoce nuestros servicios"
      href="/servicios"
      variant="primary"
    />
  </div>

  <div class="adaptability__benefits">
    {benefits.map((benefit) => (
      <article class="adaptability__item">
        <span class="adaptability__number">{benefit.number}</span>

        <div>
          <h3>{benefit.title}</h3>
          <p>{benefit.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .adaptability {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-16);
  }

  .adaptability__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .adaptability__eyebrow {
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .adaptability__content h2 {
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
  }

  .adaptability__content h2 span {
    display: block;
    color: var(--color-secondary);
  }

  .adaptability__description {
    color: var(--color-text);
    line-height: 1.8;
    max-width: 520px;
  }

  .adaptability__benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .adaptability__item {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-6);
    border-left: 3px solid var(--color-secondary);
    background: var(--color-surface);
  }

  .adaptability__number {
    color: var(--color-secondary);
    font-weight: 700;
  }

  .adaptability__item h3 {
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .adaptability__item p {
    color: var(--color-text);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .adaptability {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .adaptability :global(.button) {
        display: flex;
        width: fit-content;
        margin-inline: auto;
    }
  }
</style>