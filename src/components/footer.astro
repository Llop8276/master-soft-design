---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "Inicio", href: "/" },
  { label: "Empresa", href: "/empresa" },
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Plantillas", href: "/plantillas" },
  { label: "Contacto", href: "/contacto" },
];

const contactLinks = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/share/1Q22afbcvy/",
    external: true,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/master_soft.design/",
    external: true,
  },
  {
    label: "WhatsApp",
    href: "https://wa.me/5212215727972",
    external: true,
  },
  {
    label: "Correo",
    href: "mailto:contacto@mastersoftdesign.com",
    external: false,
  },
];
---

<footer class="footer">
  <div class="footer__container">

    <!-- BRAND -->
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="MSD - Inicio">
        MSD
      </a>

      <p>Master Soft Design</p>

      <span>Diseñamos tecnología que evoluciona.</span>
    </div>

    <!-- NAVIGATION -->
    <div class="footer__navigation">
      <h3>Explorar</h3>

      <ul>
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- CONTACT -->
    <div class="footer__contact">
      <h3>Contacto y redes sociales</h3>

      <ul>
        {
          contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

  </div>

  <!-- COPYRIGHT -->
  <div class="footer__bottom">
    <p>© {currentYear} Master Soft Design.</p>
    <p>Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-surface);
    padding: var(--space-12) var(--space-6) var(--space-4);
  }

  .footer__container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-8);

    max-width: 1200px;
    margin-inline: auto;
    padding-bottom: var(--space-12);
  }

  /* BRAND */

  .footer__logo {
    color: var(--color-surface);
    font-size: var(--font-size-3xl);
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.04em;
  }

  .footer__brand p {
    margin-top: var(--space-3);
    font-weight: 600;
  }

  .footer__brand span {
    color: var(--color-border);
    font-size: var(--font-size-sm);
  }

  /* HEADINGS */

  .footer h3 {
    margin-top: 0;
    font-size: var(--font-size-base);
  }

  /* LINKS */

  .footer ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);

    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--color-surface);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer a:hover {
    color: var(--color-secondary);
  }

  /* COPYRIGHT */

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    max-width: 1200px;
    margin-inline: auto;
    padding-top: var(--space-4);

    border-top: 1px solid rgb(255 255 255 / 20%);
  }

  .footer__bottom p {
    margin: 0;
    color: var(--color-border);
    font-size: var(--font-size-xs);
  }

  /* RESPONSIVE */

  @media (max-width: 768px) {
    .footer__container {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .footer__container {
      grid-template-columns: 1fr;
    }

    .footer__brand {
      grid-column: auto;
    }
  }
</style>